# CricketAI PoC Environment Variables

# Backend Port (default: 8000)
PORT=8000

# OpenAI API Key (optional - required only if you want to use OpenAI-POC mode)
# Get your API key from: https://platform.openai.com/api-keys
# Leave empty to use local commentary generation only
OPENAI_API_KEY=sk-your-api-key-here

# Node Environment
NODE_ENV=development
